{
  "name": "@punyamsingh/docmost-mcp",
  "version": "0.1.0",
  "description": "MCP server for self-hosted Docmost: read, search, create and update pages in Markdown",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "docmost-mcp": "build/index.js"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', 0o755)\"",
    "prepare": "npm run build",
    "start": "node build/index.js"
  },
  "keywords": [
    "mcp",
    "docmost",
    "model-context-protocol",
    "wiki",
    "markdown"
  ],
  "author": "Punyam Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punyamsingh/docmost-mcp.git"
  },
  "homepage": "https://github.com/punyamsingh/docmost-mcp#readme",
  "bugs": {
    "url": "https://github.com/punyamsingh/docmost-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
