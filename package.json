{
  "name": "@punyamsingh/docmost-mcp",
  "version": "0.6.0",
  "mcpName": "io.github.punyamsingh/docmost-mcp",
  "description": "MCP server for self-hosted Docmost: let Claude, Cursor and other AI agents read, search, create and edit wiki pages in Markdown. No Enterprise API key needed.",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "docmost-mcp": "build/index.js"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', 0o755)\"",
    "prepare": "npm run build",
    "start": "node build/index.js",
    "test": "npm run build && tsc -p test && node --test \"test/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "docmost",
    "docmost-mcp",
    "self-hosted",
    "wiki",
    "knowledge-base",
    "documentation",
    "markdown",
    "claude",
    "claude-code",
    "claude-desktop",
    "cursor",
    "ai",
    "ai-agents",
    "llm",
    "confluence-alternative",
    "notion-alternative"
  ],
  "author": "Punyam Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punyamsingh/docmost-mcp.git"
  },
  "homepage": "https://github.com/punyamsingh/docmost-mcp#readme",
  "bugs": {
    "url": "https://github.com/punyamsingh/docmost-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.9.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hocuspocus/server": "^4.9.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
